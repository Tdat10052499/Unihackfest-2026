# N.E.D Wallet — MẪU biến môi trường (được commit, KHÔNG chứa giá trị thật).
# Cách dùng: cp .env.example .env rồi điền giá trị. Chỉ dùng một file .env (đã gitignore).
# LƯU Ý: mọi biến EXPO_PUBLIC_* bị đóng gói vào bundle app/web → chỉ đặt giá trị công khai, KHÔNG đặt khoá bí mật.

# Solana / ned_program (devnet)
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_ANCHOR_PROGRAM_ID=8azx4HdoXQ8VQFn5QWaoBU2PMg3RX99Z2agrWyMbX5Wh

# Helius RPC — https://dashboard.helius.dev (giới hạn key theo domain vì key nằm trong bundle)
EXPO_PUBLIC_HELIUS_DEVNET_URL=
EXPO_PUBLIC_HELIUS_MAINNET_URL=

# Dynamic — Dynamic Console › Developers › API & SDK Keys (Environment ID là công khai)
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Jupiter Tokens API — public Free-tier key (bundled into web/app; never use a secret key)
EXPO_PUBLIC_JUPITER_API_KEY=

# Tuỳ chọn — chỉ dùng khi không có URL Helius ở trên (mặc định RPC công khai của Solana)
# EXPO_PUBLIC_HELIUS_API_KEY=
# EXPO_PUBLIC_SOLANA_DEVNET_RPC=
# EXPO_PUBLIC_SOLANA_MAINNET_RPC=
# EXPO_PUBLIC_SOLANA_RPC=
# EXPO_PUBLIC_SOLANA_RPC_URL=
