# N.E.D phone app — environment variable TEMPLATE (committed, holds NO real values).
# Usage: cp .env.example .env, then fill in the values. Use a single .env file (gitignored).
# NOTE: every EXPO_PUBLIC_* variable is bundled into the app/web build → public values only, NEVER a secret key.

# Solana / ned_program (devnet)
# EXPO_PUBLIC_SOLANA_CLUSTER is no longer read: this build is devnet-only (constants/chain.ts CLUSTER)
EXPO_PUBLIC_ANCHOR_PROGRAM_ID=8azx4HdoXQ8VQFn5QWaoBU2PMg3RX99Z2agrWyMbX5Wh

# Devnet RPC — read order (services/chain/connection.ts): EXPO_PUBLIC_HELIUS_DEVNET_URL → EXPO_PUBLIC_SOLANA_DEVNET_RPC → https://api.devnet.solana.com
# Helius RPC — https://dashboard.helius.dev (restrict the key by domain, since the key is in the bundle)
EXPO_PUBLIC_HELIUS_DEVNET_URL=
# Mainnet RPC, read-only: only the .sol name lookup (services/identity/sns.ts) uses it
EXPO_PUBLIC_HELIUS_MAINNET_URL=

# Dynamic — Dynamic Console › Developers › API & SDK Keys (the Environment ID is public)
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Optional — devnet: used only without EXPO_PUBLIC_HELIUS_DEVNET_URL (defaults to Solana's public RPC)
# EXPO_PUBLIC_SOLANA_DEVNET_RPC=

# Dev harness /dev/milestone in a production web export (never set it for the public demo build)
# EXPO_PUBLIC_DEV_TOOLS=1

# Web hosts (build-plan B1, D16). Invite links (…/c/<fund>#k=…) point at the Workspace: its /c/:fund router (W2)
# sends phones on to the mobile build with the key intact, and imports the key on computers.
EXPO_PUBLIC_MOBILE_ORIGIN=https://tdat10052499.github.io/Unihackfest-2026
EXPO_PUBLIC_WORKSPACE_ORIGIN=https://unihackfest-2026.vercel.app
