# N.E.D Wallet — biến môi trường (copy thành .env rồi điền giá trị)
# LƯU Ý: mọi biến EXPO_PUBLIC_* bị đóng gói vào app/web → KHÔNG đặt khoá bí mật ở đây.

# Solana / Anchor
EXPO_PUBLIC_SOLANA_CLUSTER=
EXPO_PUBLIC_ANCHOR_PROGRAM_ID=8azx4HdoXQ8VQFn5QWaoBU2PMg3RX99Z2agrWyMbX5Wh
EXPO_PUBLIC_SOLANA_RPC=
EXPO_PUBLIC_SOLANA_RPC_URL=
EXPO_PUBLIC_SOLANA_DEVNET_RPC=
EXPO_PUBLIC_SOLANA_MAINNET_RPC=

# Helius
EXPO_PUBLIC_HELIUS_API_KEY=
EXPO_PUBLIC_HELIUS_DEVNET_URL=
EXPO_PUBLIC_HELIUS_MAINNET_URL=

# Dynamic — auth + ví nhúng (Dynamic Console › Developers › API & SDK Keys)
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
