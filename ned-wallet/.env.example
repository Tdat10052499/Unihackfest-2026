# N.E.D Wallet — MẪU biến môi trường (được commit, KHÔNG chứa giá trị thật).
# Cách dùng: cp .env.example .env rồi điền giá trị. Chỉ dùng một file .env (đã gitignore).
# LƯU Ý: mọi biến EXPO_PUBLIC_* bị đóng gói vào bundle app/web → chỉ đặt giá trị công khai, KHÔNG đặt khoá bí mật.

# Solana / ned_program (devnet)
# EXPO_PUBLIC_SOLANA_CLUSTER is no longer read: this build is devnet-only (constants/chain.ts CLUSTER)
EXPO_PUBLIC_ANCHOR_PROGRAM_ID=8azx4HdoXQ8VQFn5QWaoBU2PMg3RX99Z2agrWyMbX5Wh

# Devnet RPC — thứ tự đọc (services/chain/connection.ts): EXPO_PUBLIC_HELIUS_DEVNET_URL → EXPO_PUBLIC_SOLANA_DEVNET_RPC → https://api.devnet.solana.com
# Helius RPC — https://dashboard.helius.dev (giới hạn key theo domain vì key nằm trong bundle)
EXPO_PUBLIC_HELIUS_DEVNET_URL=
EXPO_PUBLIC_HELIUS_MAINNET_URL=

# Dynamic — Dynamic Console › Developers › API & SDK Keys (Environment ID là công khai)
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Jupiter Tokens API — public Free-tier key from https://portal.jup.ag (bundled into web/app; never use a secret key).
# Leave empty in this file; put your own key in .env. The key that used to be here must be rotated.
EXPO_PUBLIC_JUPITER_API_KEY=

# Tuỳ chọn — devnet: chỉ dùng khi không có EXPO_PUBLIC_HELIUS_DEVNET_URL (mặc định RPC công khai của Solana)
# EXPO_PUBLIC_SOLANA_DEVNET_RPC=
# Tuỳ chọn — mainnet (chỉ đọc, Swap/xStocks đang ẩn): dùng khi không có EXPO_PUBLIC_HELIUS_MAINNET_URL
# EXPO_PUBLIC_HELIUS_API_KEY=
# EXPO_PUBLIC_SOLANA_MAINNET_RPC=

# Dev harness /dev/milestone in a production web export (never set it for the public demo build)
# EXPO_PUBLIC_DEV_TOOLS=1

# Web hosts (build-plan B1, D16). Invite links (…/c/<fund>#k=…) point at the Workspace: its /c/:fund router (W2)
# sends phones on to the mobile build with the key intact, and imports the key on computers.
EXPO_PUBLIC_MOBILE_ORIGIN=https://tdat10052499.github.io/Unihackfest-2026
EXPO_PUBLIC_WORKSPACE_ORIGIN=https://unihackfest-2026.vercel.app
