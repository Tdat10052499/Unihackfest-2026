# N.E.D Workspace — environment variable NAMES (values go in .env.local or the Vercel project settings).
# Every VITE_* value is bundled into the public web build: never put a secret here.

# Dynamic environment ID: the SAME value as EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID in ned-wallet (same users, same wallets)
VITE_DYNAMIC_ENVIRONMENT_ID=

# Devnet RPC (Helius URL restricted to the Workspace domain); empty = public devnet RPC
VITE_HELIUS_DEVNET_URL=

# Optional override of the program ID in the IDL
VITE_PROGRAM_ID=

# Mobile web build (GitHub Pages) and this Workspace's own origin
VITE_MOBILE_ORIGIN=https://tdat10052499.github.io/Unihackfest-2026
VITE_WORKSPACE_ORIGIN=
